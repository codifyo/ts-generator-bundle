{
    "name": "codifyo/ts-generator-bundle",
    "description": "Symfony Bundle for generating TypeScript definitions from Symfony Serializer metadata",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Valin"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/serializer": "^7.0 || ^8.0",
        "symfony/property-info": "^7.0 || ^8.0",
        "symfony/property-access": "^7.0 || ^8.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0",
        "symfony/string": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Codifyo\\TsGeneratorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codifyo\\TsGeneratorBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "^7.0 || ^8.0"
        }
    }
}
