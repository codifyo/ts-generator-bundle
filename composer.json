{
    "name": "codifyo/ts-generator-bundle",
    "description": "Symfony Bundle for generating TypeScript definitions from Symfony Serializer metadata",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Valin"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/console": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/filesystem": "^7.4 || ^8.1",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/property-access": "^7.4 || ^8.1",
        "symfony/property-info": "^7.4 || ^8.1",
        "symfony/serializer": "^7.4 || ^8.1",
        "symfony/type-info": "^7.4 || ^8.1"
    },
    "require-dev": {
        "doctrine/collections": "^2.2",
        "doctrine/orm": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "doctrine/orm": "Interprets OneToMany / ManyToMany / ManyToOne / OneToOne relations",
        "jms/serializer-bundle": "Enables the 'jms' extraction mode",
        "phpstan/phpdoc-parser": "Lets PropertyInfo resolve generic PHPDoc types (Collection<int, Foo>, array<Foo>)"
    },
    "autoload": {
        "psr-4": {
            "Codifyo\\TsGeneratorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codifyo\\TsGeneratorBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "require": "^7.4 || ^8.1"
        }
    }
}
